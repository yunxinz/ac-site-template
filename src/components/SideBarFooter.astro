---
import { url } from "../config";

const socials = [
    { label: "GitHub", href: "https://github.com/yourusername", icon: "news.png" },
    { label: "LinkedIn", href: "https://www.linkedin.com/in/yourusername", icon: "brewster.png" },
    { label: "WhatsApp", href: "#", icon: "whatsapp.png" },
    { label: "Instagram", href: "https://www.instagram.com/yourusername/", icon: "instagram.png" },
];
---

{/* Desktop footer — gradient mask + full-width theme toggle + vertical social
     list, pinned to the sidebar bottom by the flex column (only shown at lg+). */}
<div
    class="hidden lg:block shrink-0 pointer-events-none bg-ac-cream-dark justify-center h-12 [mask-image:linear-gradient(transparent,#000000)]"
>
</div>

<div class="hidden lg:block shrink-0 px-4 pb-2 bg-ac-cream-dark">
    <button
        onclick="toggleTheme()"
        class="flex items-center gap-2 px-3 py-1.5 w-full rounded-ac-md transition-colors hover:bg-ac-sand text-sm"
        aria-label="Toggle theme"
        title="Toggle theme"
    >
        <img src={url('leaf_dark.png')} alt="" class="w-5 h-5 rounded-ac-sm show-light" />
        <img src={url('leaf_light.png')} alt="" class="w-5 h-5 rounded-ac-sm show-dark" />
        <span class="show-light">Dark Mode</span>
        <span class="show-dark">Light Mode</span>
    </button>
</div>

<div
    class="hidden lg:flex shrink-0 flex-col items-start px-4 pb-5 pt-1 bg-ac-cream-dark gap-1"
>
    {socials.map((s) => (
        <a
            href={s.href}
            target="_blank"
            class="flex items-center gap-2 px-3 py-1.5 rounded-ac-md transition-colors hover:bg-ac-sand text-sm"
            aria-label={s.label}
            title={s.label}
        >
            <img src={url(s.icon)} alt={s.label} class="w-5 h-5 rounded-ac-sm" />
            <span>{s.label}</span>
        </a>
    ))}
</div>

{/* Mobile footer — one compact row of icon-only buttons. Collapses the entire
     footer to a single line so short viewports stop squeezing the menu above
     and force-scrolling to reach the links. */}
<div class="flex lg:hidden shrink-0 items-center justify-around gap-1 bg-ac-cream-dark px-3 pt-2 pb-4">
    <button
        onclick="toggleTheme()"
        class="flex items-center justify-center w-10 h-10 rounded-ac-md transition-colors hover:bg-ac-sand"
        aria-label="Toggle theme"
        title="Toggle theme"
    >
        <img src={url('leaf_dark.png')} alt="" class="w-5 h-5 rounded-ac-sm show-light" />
        <img src={url('leaf_light.png')} alt="" class="w-5 h-5 rounded-ac-sm show-dark" />
    </button>
    {socials.map((s) => (
        <a
            href={s.href}
            target="_blank"
            class="flex items-center justify-center w-10 h-10 rounded-ac-md transition-colors hover:bg-ac-sand"
            aria-label={s.label}
            title={s.label}
        >
            <img src={url(s.icon)} alt={s.label} class="w-5 h-5 rounded-ac-sm" />
        </a>
    ))}
</div>
