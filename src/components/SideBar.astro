---
import SideBarFooter from "./SideBarFooter.astro";
import { Image } from "astro:assets";
import SideBarMenu from "./SideBarMenu.astro";
import { url } from "../config";
const { sideBarActiveItemID } = Astro.props;
---

<div class="drawer-side z-40">
    <label for="my-drawer" class="drawer-overlay"></label>
    <aside
        class="px-2 pt-2 h-[100dvh] w-[19rem] bg-ac-cream-dark text-ac-text flex flex-col"
    >
        <div class="w-fit mx-auto mt-3 mb-4 lg:mt-5 lg:mb-6 shrink-0">
            <a href={url('')}>
                <div
                    class="avatar transition ease-in-out hover:scale-[102%] block m-auto"
                >
                    <div class="w-[6rem] lg:w-[8.5rem] overflow-hidden">
                        <Image
                            class="mask mask-circle"
                            format="webp"
                            width={300}
                            height={300}
                            src={url('profile.jpg')}
                            alt="Profile image"
                        />
                    </div>
                </div>
            </a>
        </div>
        {/* The menu scrolls in its own region at every breakpoint so the footer
            below stays pinned to the sidebar bottom. daisyUI's .drawer-side is
            always a 100dvh overflow-auto box, so the sidebar must manage its own
            height instead of relying on sticky offsets. */}
        <div class="flex-1 min-h-0 overflow-y-auto">
            <SideBarMenu sideBarActiveItemID={sideBarActiveItemID} />
        </div>
        <SideBarFooter />
    </aside>
</div>
